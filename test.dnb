func makeCounter() -> () -> Int {
    var count = 0;

    func counter() -> Int {
        count++;
        return count;
    }

    return counter;
}

func main() -> Void {
    let counter = makeCounter();

    print(counter());
    print(counter());
    print(counter());

    let anotherCounter = makeCounter();

    print(anotherCounter());
    print(anotherCounter());

    print(counter());
}
