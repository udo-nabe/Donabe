// Fibonacci
// 生成する数字の数
print("How many do you want to generate?> ");
let limit = input().toInt();
var a = 1;
var b = 1;
var result = "[1, 1";

for var i = 0; i < limit - 2; i++ {
  let next = a + b;
  a = b;
  b = next;
  result += ", " + string(next);
}
print(result + "]");
print("length: " + result.length.toString());