    func add(a: Int, b: Int) -> Int {
        return a + b;
    }

func main() -> Void {
    var sum = 0;
    let start = now();
    for var i = 0; i < 10000000; i++ {
        sum = add(sum, i);
    }
    let end = now();
    print("sum: " + sum.toString());
    print("elapsed: " + (end - start).toString());
}