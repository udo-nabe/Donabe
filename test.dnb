func abs(x: Int) -> Int {
    if x < 0 {
        return -x;
    }

    return x;
}

func clamp(x: Int, min: Int, max: Int) -> Int {
    if x < min {
        return min;
    }

    if x > max {
        return max;
    }

    return x;
}

func calculate_score(a: Int, b: Int, c: Int) -> Int {
    let x = abs(a - b);
    let y = abs(b - c);

    return clamp(x + y, 0, 100);
}

let values = [12, 5, 8, 15, 3, 20, 7, 11, 4, 9];

var total = 0;
var round = 0;

while round < 100000 {
    var i = 0;

    while i < 8 {
        let a = values[i];
        let b = values[i + 1];
        let c = values[i + 2];

        total = total + calculate_score(a, b, c);

        i = i + 1;
    }

    round = round + 1;
}

print(total);