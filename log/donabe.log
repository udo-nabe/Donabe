00:08:21.315 [main] TRACE i.g.udonabe.donabe.Main  - Source: 
// Fibonacci
// 生成する数字の数
let limit = 10;
var a = 1;
var b = 1;
var result = "[1, 1";

for var i = 0; i < limit - 2; i++ {
  let next = a + b;
  a = b;
  b = next;
  result += ", " + next;
}
print(result + "]");
